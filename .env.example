# App
LOG_LEVEL=info
MAX_PDF_SIZE_MB=50
ENVIRONMENT=development

# Redis (for async jobs and session store)
REDIS_URL=redis://localhost:6379/0

# Ollama (local, free — used in development)
OLLAMA_BASE_URL=http://localhost:11434

# RAG knowledge base
CHROMA_PERSIST_DIR=./data/chroma

# IMPORTANT: Do NOT add personal API keys here.
# API keys are supplied by users per-request via X-API-Key header (BYOK).
# You only need a key here if you want a server-side default for testing.
# ANTHROPIC_API_KEY=sk-ant-...  # optional, only for testing
